                        if _G_CurrentStage == "Stage2" and tempatTaruh2 then
                            targetPart = tempatTaruh2
                        else
                            targetPart = tempatTaruh1 or tempatTaruh2
                        end
                    end
                    if targetPart then targetCFrame = targetPart.CFrame end
                end
                if targetCFrame then burstInstantTeleport(targetCFrame) end
            end)
        end
    end
end)

