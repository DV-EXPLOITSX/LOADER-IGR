local WHITELIST_NAME = {
    "baseplate", "ground", "floor", "road", "terrain", "spawnlocation", "tanah",
    "ekonomi", "bedilpusat", "activejobs", "brewog", "job",
    "npc", "speakerfolder", "indikator", "trigger", "zone",
    "bp", "deliveryvehicle", "driveseat",
}

local WHITELIST_PATH = {
    "Map.Tanah",
    "Map.Behavior",
}

local bypassActive = false
local hidden = false
local savedObjects = {}
local deletedCount = 0
local totalTarget = 0

local wheelsBypassActive = false
local _removedWheels = {}
local _lastBpRef = nil
local _wheelsRemovedCount = 0
local _wheelsInterval = nil

local function isWhitelisted(name)
    local lower = name:lower()
    for _, wl in pairs(WHITELIST_NAME) do
        if lower:find(wl) then return true end
    end
    return false
end

local function isWhitelistedPath(obj)
    for _, path in pairs(WHITELIST_PATH) do
        local parts = {}
        for segment in path:gmatch("[^%.]+") do
            table.insert(parts, segment)
        end
        local current = workspace
        local valid = true
        for _, segment in ipairs(parts) do
            if current then
                current = current:FindFirstChild(segment)
            else
                valid = false
                break
            end
        end
        if valid and current and (obj == current or obj:IsDescendantOf(current)) then
            return true
        end
    end
    return false
end

local function isCharacterOrPlayer(obj)
    if LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then return true end
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character and obj:IsDescendantOf(player.Character) then return true end
    end
    return false
end

local function isSafeToDelete(obj)
    if obj:IsA("Terrain") then return false end
    if isWhitelisted(obj.Name) then return false end
    if isWhitelistedPath(obj) then return false end
    if isCharacterOrPlayer(obj) then return false end

    local ekonomi = workspace:FindFirstChild("Ekonomi")
    if ekonomi and obj:IsDescendantOf(ekonomi) then return false end

    local speaker = workspace:FindFirstChild("SpeakerFolder")
    if speaker and obj:IsDescendantOf(speaker) then return false end

    local vehicle = workspace:FindFirstChild("BP")
    if vehicle and obj:IsDescendantOf(vehicle) then return false end

    for _, tagged in pairs(CollectionService:GetTagged("DeliveryVehicle")) do
        if tagged and obj:IsDescendantOf(tagged) then return false end
    end

    if not (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("UnionOperation") or obj:IsA("MeshPart")) then
        return false
    end

    return true
end

local function isMyBp(bp)
    if not bp or not bp.Parent then return false end
    if not bp.PrimaryPart then return false end

    local ownerId = bp:GetAttribute("OwnerUserId")
    if ownerId ~= nil then
        return ownerId == LocalPlayer.UserId
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local dist = (bp.PrimaryPart.Position - hrp.Position).Magnitude
    return dist <= 50
end

local function removeWheelsFromBp(bp)
    if not bp or not bp.Parent then return 0 end
    if not isMyBp(bp) then return 0 end

    local count = 0

    for _, obj in ipairs(bp:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            local n = obj.Name:lower()
            if n == "wheels" or n:find("wheel") then
                _removedWheels[obj] = bp
                obj.Parent = nil
                count = count + 1
            end
        elseif obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("wheel") then
                _removedWheels[obj] = bp
                obj.Parent = nil
                count = count + 1
            end
        end
    end

    for _, child in ipairs(bp:GetDescendants()) do
        if child and child.Parent then
            if child:IsA("Model") or child:IsA("Folder") then
                local n = child.Name:lower()
                if n == "wheels" or n:find("wheel") then
                    _removedWheels[child] = child.Parent
                    child.Parent = nil
                    count = count + 1
                end
            elseif child:IsA("BasePart") then
                local n = child.Name:lower()
                if n:find("wheel") then
                    _removedWheels[child] = child.Parent
                    child.Parent = nil
                    count = count + 1
                end
            end
        end
    end

    return count
end

local function applyWheelsBypass()
    if not wheelsBypassActive then return end

    local bp = workspace:FindFirstChild("BP")
    if not bp then
        _lastBpRef = nil
        return
    end

    if bp ~= _lastBpRef then
        _lastBpRef = bp
        _removedWheels = {}
        _wheelsRemovedCount = 0
    end

    if isMyBp(bp) then
        local removed = removeWheelsFromBp(bp)
        if removed > 0 then
            _wheelsRemovedCount = _wheelsRemovedCount + removed
            WheelsCountLabel.Text = "Wheels removed: " .. _wheelsRemovedCount
        end
    end
end

local function restoreWheels()
    local restored = 0
    for obj, parent in pairs(_removedWheels) do
        pcall(function()
            if obj and obj.Parent == nil and parent then
                obj.Parent = parent
                restored = restored + 1
            end
        end)
    end
    _removedWheels = {}
    _wheelsRemovedCount = 0
    WheelsCountLabel.Text = "Wheels removed: 0"
    return restored
end

local function updateProgress(current, total)
    total = total or totalTarget
    local percent = total > 0 and math.clamp(current / total, 0, 1) or 0
    ProgressFill.Size = UDim2.new(percent, 0, 1, 0)
    ProgressText.Text = math.floor(percent * 100) .. "%  (" .. current .. "/" .. total .. ")"
end

local function bypassMap()
    deletedCount = 0
    savedObjects = {}
    totalTarget = 0

    local mapFolder = workspace:FindFirstChild("Map")
    if not mapFolder then
        StatusLabel.Text = "⚠️ MAP TIDAK DITEMUKAN"
        StatusLabel.TextColor3 = CLR.RED
        return
    end

    local targets = {}
    for _, obj in pairs(mapFolder:GetDescendants()) do
        if isSafeToDelete(obj) then
            table.insert(targets, obj)
        end
    end
    totalTarget = #targets

    for i, obj in ipairs(targets) do
        pcall(function()
            savedObjects[obj] = obj.Parent
            obj.Parent = nil
            deletedCount = deletedCount + 1
        end)

        if i % 50 == 0 or i == totalTarget then
            updateProgress(i, totalTarget)
            task.wait()
        end
    end

    updateProgress(deletedCount, totalTarget)
    StatusLabel.Text = "✅ MAP DIBERSIHKAN"
    StatusLabel.TextColor3 = CLR.BLUE_LIGHT
    CountLabel.Text = "Deleted: " .. deletedCount .. "  |  Restored: 0"

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Map Bypass",
            Text = "🗑️ Berhasil! Deleted: " .. deletedCount,
            Duration = 3
        })
    end)
end

local function restoreMap()
    local restored = 0
    for obj, parent in pairs(savedObjects) do
        if obj and parent then
            pcall(function()
                obj.Parent = parent
                restored = restored + 1
            end)
        end
    end
    savedObjects = {}
    deletedCount = 0
    totalTarget = 0

    updateProgress(0, 1)
    StatusLabel.Text = "♻️ MAP RESTORED"
    StatusLabel.TextColor3 = CLR.YELLOW
    CountLabel.Text = "Deleted: 0  |  Restored: " .. restored

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Map Restore",
            Text = "♻️ Direstore: " .. restored,
            Duration = 3
        })
    end)
end

local function animateButton(btn)
    local pulse = Instance.new("Frame")
    pulse.Size = UDim2.new(1, 0, 1, 0)
    pulse.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    pulse.BackgroundTransparency = 0.7
    pulse.BorderSizePixel = 0
    pulse.ZIndex = 1
    pulse.Parent = btn
    makeCorner(pulse, 8)
    local tween = TweenService:Create(pulse, TweenInfo.new(0.3), {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 10, 1, 10),
        Position = UDim2.new(0, -5, 0, -5),
    })
    tween:Play()
    tween.Completed:Connect(function()
        pulse:Destroy()
    end)
end

