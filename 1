local function getMyVehicle()
    for _, vehicle in ipairs(CollectionService:GetTagged("DeliveryVehicle")) do
        if vehicle.Parent and vehicle:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
            if vehicle.PrimaryPart and vehicle.PrimaryPart.Parent then
                return vehicle
            end
        end
    end
    local bp = Workspace:FindFirstChild("BP")
    if bp and bp.PrimaryPart and bp.PrimaryPart.Parent then
        local ownerId = bp:GetAttribute("OwnerUserId")
        if ownerId ~= nil and ownerId ~= LocalPlayer.UserId then return nil end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dist = (bp.PrimaryPart.Position - hrp.Position).Magnitude
            if dist > 50 then return nil end
        end
        return bp
    end
    return nil
end

local function getDriveSeat()
    local vehicle = getMyVehicle()
    if not vehicle then return nil end
    local ds = vehicle:FindFirstChild("DriveSeat")
    if ds and ds:IsA("VehicleSeat") then return ds end
    for _, part in ipairs(vehicle:GetDescendants()) do
        if part:IsA("VehicleSeat") then return part end
    end
    return nil
end

local function sitInVehicle()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return false end
    local vehicle = getMyVehicle()
    if not vehicle then return false end
    local ds = getDriveSeat()
    if not ds then return false end
    if ds.Occupant and ds.Occupant ~= humanoid then return false end
    
    hrp.CFrame = ds.CFrame + Vector3.new(0, 2.5, 0)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    task.wait(0.15)
    
    for i = 1, 3 do
        pcall(function() ds:Sit(humanoid) end)
        task.wait(0.15)
        if ds.Occupant == humanoid then return true end
    end
    return false
end

