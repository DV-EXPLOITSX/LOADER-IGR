local function breakableWait(seconds)
    if seconds <= 0 then return true end
    local iterations = math.floor(seconds * 20)
    for _ = 1, iterations do
        if not autoDeliveryActive and not autoDriveActive then return false end
        task.wait(0.05)
    end
    return autoDeliveryActive or autoDriveActive
end

