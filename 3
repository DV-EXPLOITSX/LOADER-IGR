task.spawn(function()
    local oldIdled
    oldIdled = LocalPlayer.Idled:Connect(function()
        if _G_AntiAfkActive then
            VirtualUser:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
            task.wait(1)
            VirtualUser:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
        end
    end)
    
    while true do
        task.wait(_G_ActionDelay)
        
        if not remoteEventConnection then
            hookGameRemotes()
        end
        
        if _G_AutoFarmActive then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                local userId = LocalPlayer.UserId
                local activeJobs = Workspace:FindFirstChild("Ekonomi") and Workspace.Ekonomi:FindFirstChild("ActiveJobs")
                local myJob = activeJobs and activeJobs:FindFirstChild("Brewog_" .. tostring(userId))
                
                local targetCFrame = nil
                
                if not myJob then
                    _G_CurrentStage = "Progress1"
                    local jobTrigger = Workspace.Ekonomi.Job:FindFirstChild("Brewog")
                    if jobTrigger then
                        targetCFrame = jobTrigger:IsA("BasePart") and jobTrigger.CFrame or jobTrigger:GetPivot()
                    end
                else
                    local tempatAmbil = myJob:FindFirstChild("TempatAmbil")
                    local tempatTaruh1 = myJob:FindFirstChild("Taruh1")
                    local tempatTaruh2 = myJob:FindFirstChild("Taruh2")
                    local holdingTool = char:FindFirstChildOfClass("Tool")
                    
                    local targetPart = nil
                    
                    if not holdingTool and tempatAmbil then
                        targetPart = tempatAmbil
                    else
                        if _G_CurrentStage == "Stage2" and tempatTaruh2 then
                            targetPart = tempatTaruh2
                        else
                            targetPart = tempatTaruh1 or tempatTaruh2
                        end
                    end
                    
                    if targetPart then
                        targetCFrame = targetPart.CFrame
                    end
                end
                
                if targetCFrame then
                    burstInstantTeleport(targetCFrame)
                end
            end)
        end
    end
end)
