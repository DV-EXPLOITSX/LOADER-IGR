local function executeDeliveryToTarget(targetPos)
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not autoDeliveryActive then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid or not autoDeliveryActive then return end
        local vehicle = getMyVehicle()
        if not vehicle or not vehicle.PrimaryPart or not autoDeliveryActive then return end
        
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored = false end
        end
        
        local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        unlockVehicle(vehicle)
        task.wait(0.05)
        
        if not breakableWait(deliverySettings.DelayCharTP) then return end
        if not autoDeliveryActive then return end
        hrp.CFrame = targetCFrame + Vector3.new(0, 2, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        
        if not breakableWait(deliverySettings.DelayCarTP) then return end
        if not autoDeliveryActive then return end
        vehicle:SetPrimaryPartCFrame(targetCFrame)
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
        task.wait(0.04)
        
        if LockSeatEnabled then
            lockSeat_forceSit(humanoid, vehicle)
        else
            sitToSeat(humanoid, vehicle)
        end
        
        waitForJobState("WAITING", 10)
        local confirmed = jobState == "WAITING" or jobState == "RETURNING"
        if confirmed and autoDeliveryActive then
            lockVehicle(vehicle)
            task.wait(0.15)
            if LockSeatEnabled then lockSeat_forceSit(humanoid, vehicle) end
        end
        waitForJobComplete(30)
        unlockVehicle(vehicle)
    end)
end

