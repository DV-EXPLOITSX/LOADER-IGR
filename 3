local function switchTab(tabName)
    activeTabName = tabName
    ContainerMain.Visible = (tabName == "Main")
    ContainerH42.Visible = (tabName == "H42")
    ContainerLight.Visible = (tabName == "Light")
    ContainerBank.Visible = (tabName == "Bank")
    
    local tabs = {
        Main = TabMainBtn,
        H42 = TabH42Btn,
        Light = TabLightBtn,
        Bank = TabBankBtn,
    }
    
    for name, btn in pairs(tabs) do
        if name == tabName then
            btn.BackgroundColor3 = Color3.fromRGB(180, 25, 25)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(40, 22, 22)
            btn.TextColor3 = Color3.fromRGB(220, 180, 180)
        end
    end
end

