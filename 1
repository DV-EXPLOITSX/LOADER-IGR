local function getGroundY(x, z, y, vehicle)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {vehicle, LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local rayOrigin = Vector3.new(x, y + 500, z)
    local result = Workspace:Raycast(rayOrigin, Vector3.new(0, -1000, 0), rayParams)
    if result then
        return result.Position.Y + groundHeight
    end
    return y + groundHeight
end

local function flyToPosition(vehicle, targetPos, label)
    if not vehicle or not vehicle.PrimaryPart then return false end
    local ownerId = vehicle:GetAttribute("OwnerUserId")
    if ownerId ~= nil and ownerId ~= LocalPlayer.UserId then return false end
    
    for _, part in ipairs(vehicle:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end
    task.wait(0.15)
    
    local primaryPart = vehicle.PrimaryPart
    local driveSeat = getDriveSeat()
    
    local flyTargetY
    if noFlyMode then
        flyTargetY = getGroundY(targetPos.X, targetPos.Z, targetPos.Y, vehicle)
    else
        flyTargetY = targetPos.Y + flyHeight
    end
    
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid or not humanoid.SeatPart then
        sitInVehicle()
        task.wait(0.3)
        char = LocalPlayer.Character
        humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if not humanoid or not humanoid.SeatPart then return false end
    end
    
    pcall(function()
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then part:SetNetworkOwner(LocalPlayer) end
        end
    end)
    
    local savedState = {}
    pcall(function()
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                if part == driveSeat then
                    savedState[part] = "SKIP"
                else
                    savedState[part] = {
                        CanCollide = part.CanCollide,
                        CanQuery = part.CanQuery,
                        CanTouch = part.CanTouch
                    }
                end
            end
        end
    end)
    
    if noClipEnabled then
        pcall(function()
            for _, part in ipairs(vehicle:GetDescendants()) do
                if part:IsA("BasePart") and part ~= driveSeat then
                    part.CanCollide = false
                    part.CanQuery = false
                    part.CanTouch = false
                end
            end
        end)
    end
    
    if noFlyMode then
        if AD_PhaseLabel then
            AD_PhaseLabel.Text = "🎯 Phase: GROUND MOVE"
            AD_PhaseLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        end
        pcall(function()
            primaryPart.CFrame = CFrame.new(primaryPart.Position.X, flyTargetY, primaryPart.Position.Z)
            primaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            primaryPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
        task.wait(0.1)
    else
        if AD_PhaseLabel then
            AD_PhaseLabel.Text = "🎯 Phase: ASCEND"
            AD_PhaseLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
        end
        local ascendTimeout = tick() + 5
        while autoDriveActive and (tick() < ascendTimeout) do
            local currentY = primaryPart.Position.Y
            local altDiff = flyTargetY - currentY
            if altDiff <= 1 then break end
            pcall(function()
                local newY = math.min(currentY + 15, flyTargetY)
                primaryPart.CFrame = CFrame.new(primaryPart.Position.X, newY, primaryPart.Position.Z)
                primaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                primaryPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
            task.wait(0.05)
        end
    end
    
    if not autoDriveActive then
        if noClipEnabled then
            pcall(function()
                for part, state in pairs(savedState) do
                    if part and part.Parent and state ~= "SKIP" and type(state) == "table" then
                        part.CanCollide = state.CanCollide
                        part.CanQuery = state.CanQuery
                        part.CanTouch = state.CanTouch
                    end
                end
            end)
        end
        return false
    end
    
    if AD_PhaseLabel then
        if noFlyMode then
            AD_PhaseLabel.Text = "🎯 Phase: GROUND MOVE"
            AD_PhaseLabel.TextColor3 = Color3.fromRGB(200, 255, 150)
        else
            AD_PhaseLabel.Text = "🎯 Phase: FLY"
            AD_PhaseLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        end
    end
    
    local flyCFrame = CFrame.new(targetPos.X, flyTargetY, targetPos.Z)
    local flyTimeout = tick() + 30
    local runConnection
    local flyDone = false
    
    runConnection = RunService.Heartbeat:Connect(function()
        if flyDone or not autoDriveActive then
            if runConnection then runConnection:Disconnect() end
            return
        end
        if tick() > flyTimeout then
            if runConnection then runConnection:Disconnect() end
            return
        end
        
        if noClipEnabled then
            pcall(function()
                for _, part in ipairs(vehicle:GetDescendants()) do
                    if part:IsA("BasePart") and part ~= driveSeat then
                        part.CanCollide = false
                        part.CanQuery = false
                        part.CanTouch = false
                    end
                end
            end)
        end
        
        local currentPos = primaryPart.Position
        
        if noFlyMode then
            flyCFrame = CFrame.new(targetPos.X, flyTargetY, targetPos.Z)
        end
        
        local dist = (Vector3.new(flyCFrame.X, 0, flyCFrame.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude
        
        if AD_DistanceLabel then
            AD_DistanceLabel.Text = "📏 Jarak: " .. math.floor(dist) .. " studs"
        end
        if AD_ProgressFill then
            local prog = math.clamp(1 - (dist / 500), 0, 1)
            AD_ProgressFill.Size = UDim2.new(prog, 0, 1, 0)
            AD_ProgressText.Text = math.floor(prog * 100) .. "%"
        end
        
        if dist < 5 then
            pcall(function()
                primaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                primaryPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
            if runConnection then runConnection:Disconnect() end
            flyDone = true
            return
        end
        
        local dir = (Vector3.new(flyCFrame.X, 0, flyCFrame.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Unit
        local speed
        if dynamicSpeed then
            if dist > 150 then speed = flySpeed
            elseif dist > 50 then speed = flySpeed * (0.5 + 0.5 * (dist / 150))
            else speed = flySpeed * 0.4 end
        else
            speed = flySpeed
        end
        speed = math.max(speed, 30)
        
        if noFlyMode then
            speed = speed * 0.7
        end
        
        pcall(function()
