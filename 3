local function H42_Teleport(targetPos, withMovement)
    if not _H42_Active then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not rootPart then return false end
    
    if _H42_ForceMovement then
        withMovement = true
    end
    
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.Sit = false
    end
    
    local targetCFrame = CFrame.new(targetPos)
    
    if not H42_TweenMove(targetCFrame, _H42_Duration, true) then
        return false
    end
    
    task.wait(0.1)
    
    if withMovement and _H42_MoveSim and _H42_Active then
        local baseCF = rootPart.CFrame
        
        local fwd = baseCF * CFrame.new(0, 0, -_H42_Offset)
        if not H42_TweenMove(fwd, _H42_Duration * 0.6, true) then return false end
        if not _H42_Active then return false end
        
        local bwd = baseCF * CFrame.new(3, 0, _H42_Offset)
        if not H42_TweenMove(bwd, _H42_Duration * 0.6, true) then return false end
        if not _H42_Active then return false end
        
        if not H42_TweenMove(targetCFrame, _H42_Duration * 0.8, true) then return false end
    end
    
    task.wait(_H42_Delay)
    return true
end

local function getEffectiveVerifyTimeout()
    if _H42_ForceMovement and _H42_MoveSim then
        return _H42_VerifyTimeout + 1
    end
    return _H42_VerifyTimeout
end

local function H42_TeleportVerify(targetPos, withMovement)
    local timeBefore = _G_HandlerLastUpdate
    
    H42_Teleport(targetPos, withMovement)
    
    if not _H42_EnableVerify then return true end
    
    local startWait = tick()
    local effectiveTimeout = getEffectiveVerifyTimeout()
    while (tick() - startWait) < effectiveTimeout do
        if not _H42_Active then return false end
        if _G_HandlerLastUpdate > timeBefore then
            return true
        end
        task.wait(0.1)
    end
    
    return false
end

local function H42_TeleportRetry(targetPos, withMovement)
    if not _H42_EnableRetry then
        return H42_TeleportVerify(targetPos, withMovement)
    end
    
    for attempt = 1, _H42_MaxRetry do
        if not _H42_Active then return false end
        
        local ok = H42_TeleportVerify(targetPos, withMovement)
        
        if ok then
            if attempt > 1 then
                _H42_RetryCount = _H42_RetryCount + 1
            end
            _H42_SuccessCount = _H42_SuccessCount + 1
            _H42_MissCount = 0
            return true
        end
        
        _H42_MissCount = _H42_MissCount + 1
        
        if attempt < _H42_MaxRetry then
            task.wait(_H42_RetryDelay)
        end
    end
    
    _H42_FailCount = _H42_FailCount + 1
    return false
end

task.spawn(function()
    while true do
        task.wait(0.3)
        if _H42_Active then
            pcall(function()
                if not _H42_Active then return end
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                local myJob = getMyJob()
                local holdingTool = hasTool()
                local handlerAlive = (tick() - _G_HandlerLastUpdate) < _H42_HandlerTimeout
                
                if _H42_UseHandler and handlerAlive then
                    if _G_HandlerReceivedComplete then
                        _G_HandlerReceivedComplete = false
                        _H42_NextTarget = "AmbilJob (Complete)"
                        H42_TeleportRetry(H42_WAYPOINTS.AmbilJob, true)
                        return
                    end
                    
                    if _G_HandlerJobFailed then
                        _G_HandlerJobFailed = false
                        _H42_NextTarget = "AmbilJob (Failed)"
                        H42_TeleportRetry(H42_WAYPOINTS.AmbilJob, true)
                        return
                    end
                    
                    if not myJob then
                        _H42_NextTarget = "AmbilJob"
                        if not H42_TeleportRetry(H42_WAYPOINTS.AmbilJob, true) then
                            if _H42_MissCount >= _H42_MaxMiss then
                                _H42_UseHandler = false
                                _H42_MissCount = 0
                            end
                        end
                    elseif not holdingTool then
                        _H42_NextTarget = "AmbilTool"
                        if not H42_TeleportRetry(H42_WAYPOINTS.AmbilTool, true) then
                            if _H42_MissCount >= _H42_MaxMiss then
                                _H42_UseHandler = false
                                _H42_MissCount = 0
                            end
                        end
                    elseif _G_CurrentStage == "Stage2" then
                        _H42_NextTarget = "Taruh2"
                        if not H42_TeleportRetry(H42_WAYPOINTS.Taruh2, true) then
                            if _H42_MissCount >= _H42_MaxMiss then
                                _H42_UseHandler = false
                                _H42_MissCount = 0
                            end
                        end
                    else
                        _H42_NextTarget = "Taruh1"
                        if not H42_TeleportRetry(H42_WAYPOINTS.Taruh1, true) then
                            if _H42_MissCount >= _H42_MaxMiss then
                                _H42_UseHandler = false
                                _H42_MissCount = 0
                            end
                        end
                    end
                else
                    _H42_NextTarget = "Blind Loop"
                    if not H42_Teleport(H42_WAYPOINTS.AmbilJob, true) then return end
                    
                    for i = 1, _H42_LoopCount do
                        if not _H42_Active then break end
                        H42_Teleport(H42_WAYPOINTS.AmbilTool, true)
                        H42_Teleport(H42_WAYPOINTS.Taruh1, true)
                    end
                    
                    for i = 1, _H42_LoopCount do
                        if not _H42_Active then break end
                        H42_Teleport(H42_WAYPOINTS.AmbilTool, true)
                        H42_Teleport(H42_WAYPOINTS.Taruh2, true)
                    end
                    
                    H42_Teleport(H42_WAYPOINTS.AmbilJob, true)
                end
            end)
        end
    end
end)

