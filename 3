local remoteEventConnection = nil
local function hookGameRemotes()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local jobRemotes = remotes and remotes:FindFirstChild("Job")
        local brewogUIEvent = jobRemotes and jobRemotes:FindFirstChild("BrewogUI")
        
        if brewogUIEvent and brewogUIEvent:IsA("RemoteEvent") then
            if remoteEventConnection then remoteEventConnection:Disconnect() end
            remoteEventConnection = brewogUIEvent.OnClientEvent:Connect(function(actionType, value)
                _G_HandlerLastUpdate = tick()
                
                if actionType == "Complete" then
                    _G_HandlerReceivedComplete = true
                    _G_CurrentStage = "Progress1"
                    _G_CurrentProgressCount = 0
                    _H42_CompleteCount = _H42_CompleteCount + 1
                    if ProgressDisplay then 
                        ProgressDisplay.Text = "✅ Complete! Ambil Job Baru"
                        ProgressDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
                    end
                    
                elseif actionType == "Hide" then
                    if _G_HandlerReceivedComplete then
                        _G_HandlerReceivedComplete = false
                        if ProgressDisplay then 
                            ProgressDisplay.Text = "✅ Sukses - Job Baru"
                            ProgressDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
                        end
                    else
                        _G_HandlerJobFailed = true
                        _G_CurrentStage = "Progress1"
                        _G_CurrentProgressCount = 0
                        _H42_HideFailCount = _H42_HideFailCount + 1
                        if ProgressDisplay then 
                            ProgressDisplay.Text = "❌ Gagal - Reset ke Ambil Job"
                            ProgressDisplay.TextColor3 = Color3.fromRGB(255, 100, 100)
                        end
                    end
                    
                elseif actionType == "Stage2" or actionType == "Progress2" 
                   or (actionType == "Progress" and value and type(value) == "number" and value >= 5) then
                    _G_CurrentStage = "Stage2"
                    _G_HandlerReceivedComplete = false
                    if ProgressDisplay then 
                        ProgressDisplay.Text = "Status: Tempat Taruh 2"
                        ProgressDisplay.TextColor3 = Color3.fromRGB(255, 120, 120)
                    end
                    
                elseif actionType == "Progress1" then
                    _G_CurrentProgressCount = value or 0
                    _G_HandlerReceivedComplete = false
                    if _G_CurrentProgressCount >= 5 then
                        _G_CurrentStage = "Stage2"
                        if ProgressDisplay then 
                            ProgressDisplay.Text = "Progres 1 Selesai -> Taruh 2"
                            ProgressDisplay.TextColor3 = Color3.fromRGB(255, 120, 120)
                        end
                    else
                        _G_CurrentStage = "Progress1"
                        if ProgressDisplay then 
                            ProgressDisplay.Text = "Progres 1: " .. _G_CurrentProgressCount .. " / 5"
                            ProgressDisplay.TextColor3 = Color3.fromRGB(255, 160, 160)
                        end
                    end
                end
            end)
        end
    end)
end
hookGameRemotes()

local function getEasingStyle(name)
    local map = {
        Linear = Enum.EasingStyle.Linear,
        Quad = Enum.EasingStyle.Quad,
        Sine = Enum.EasingStyle.Sine,
        Cubic = Enum.EasingStyle.Cubic,
        Quart = Enum.EasingStyle.Quart,
        Quint = Enum.EasingStyle.Quint,
        Back = Enum.EasingStyle.Back,
        Bounce = Enum.EasingStyle.Bounce,
        Elastic = Enum.EasingStyle.Elastic,
        Exponential = Enum.EasingStyle.Exponential,
        Circular = Enum.EasingStyle.Circular,
    }
    return map[name] or Enum.EasingStyle.Quad
end

local function getEasingDirection(name)
    local map = {
        In = Enum.EasingDirection.In,
        Out = Enum.EasingDirection.Out,
        InOut = Enum.EasingDirection.InOut,
    }
    return map[name] or Enum.EasingDirection.Out
end

local function H42_TweenMove(targetCFrame, duration, cancelable)
    local char = LocalPlayer.Character
    if not char then return false end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    duration = duration or _H42_Duration
    local tweenInfo = TweenInfo.new(
        duration,
        getEasingStyle(_H42_EasingStyle),
        getEasingDirection(_H42_EasingDirection)
    )
    
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    _H42_CurrentTween = tween
    tween:Play()
    
    local startTime = tick()
    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if cancelable and not _H42_Active then
            tween:Cancel()
            _H42_CurrentTween = nil
            return false
        end
        if (tick() - startTime) > (duration + _H42_FallbackTimeout) then
            tween:Cancel()
            _H42_CurrentTween = nil
            if _H42_Fallback then
                rootPart.CFrame = targetCFrame
            end
            return false
        end
        task.wait(0.03)
    end
    
    _H42_CurrentTween = nil
    return true
end

