    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local box = Instance.new("TextBox", ContainerMaxgen)
    box.BackgroundColor3 = Color3.fromRGB(35, 25, 50)
    box.BorderSizePixel = 0
    box.Position = UDim2.new(1, -95, 0, yPos)
