local remoteEventConnection = nil
local function hookGameRemotes()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local jobRemotes = remotes and remotes:FindFirstChild("Job")
        local brewogUIEvent = jobRemotes and jobRemotes:FindFirstChild("BrewogUI")
        if brewogUIEvent and brewogUIEvent:IsA("RemoteEvent") then
            if remoteEventConnection then remoteEventConnection:Disconnect() end
            remoteEventConnection = brewogUIEvent.OnClientEvent:Connect(function(actionType, value)
                if actionType == "Stage2" or actionType == "Progress2" or (actionType == "Progress" and value and type(value) == "number" and value >= 5) then
                    _G_CurrentStage = "Stage2"
                    if ProgressDisplay then 
                        ProgressDisplay.Text = "Status: Tempat Taruh 2" 
                        ProgressDisplay.TextColor3 = Color3.fromRGB(255, 120, 120) 
                    end
                elseif actionType == "Progress1" then
                    _G_CurrentProgressCount = value or 0
                    if _G_CurrentProgressCount >= 5 then
                        _G_CurrentStage = "Stage2"
                        if ProgressDisplay then 
                            ProgressDisplay.Text = "Progres 1 Selesai -> Taruh 2" 
                            ProgressDisplay.TextColor3 = Color3.fromRGB(255, 120, 120) 
                        end
                    else
                        _G_CurrentStage = "Progress1"
                        if ProgressDisplay then 
                            ProgressDisplay.Text = "Progres 1: " .. _G_CurrentProgressCount .. " / 5" 
                            ProgressDisplay.TextColor3 = Color3.fromRGB(255, 160, 160) 
                        end
                    end
                end
            end)
        end
    end)
end
