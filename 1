local function waitForJobState(targetState, timeout)
    timeout = timeout or 15
    local start = tick()
    while (tick() - start) < timeout do
        if jobState == targetState then return true end
        if targetState == "WAITING" and (jobState == "RETURNING" or jobState == "NONE") then return true end
        if targetState == "RETURNING" and jobState == "NONE" then return true end
        if not autoDeliveryActive and not autoDriveActive then return false end
        task.wait(0.1)
    end
    if targetState == "WAITING" or targetState == "RETURNING" then
        jobState = "NONE"
        currentTargetPosition = nil
    end
    return false
end

local function waitForJobComplete(timeout)
    timeout = timeout or 30
    local start = tick()
    while (tick() - start) < timeout do
        if jobState == "RETURNING" or jobState == "NONE" then return true end
        if not autoDeliveryActive and not autoDriveActive then return false end
        task.wait(0.2)
    end
    return false
end

local LockSeatEnabled = false
local _lockSeatWatchdogActive = false
local _lockSeatCurrentSeat = nil
local _lockSeatPropertyConnection = nil

local function lockSeat_forceSit(humanoid, vehicle)
    if not humanoid or not vehicle or not humanoid.Parent then return false end
    local function trySeat(seat)
        if not seat then return false end
        if not (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then return false end
        if seat.Occupant == humanoid then return true end
        pcall(function() seat:Sit(humanoid) end)
        task.wait(0.05)
        return seat.Occupant == humanoid
    end
    local bp = Workspace:FindFirstChild("BP")
    local driveSeat = bp and bp:FindFirstChild("DriveSeat")
    if trySeat(driveSeat) then
        _lockSeatCurrentSeat = driveSeat
        return true
    end
    for _, obj in ipairs(vehicle:GetDescendants()) do
        if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
            if trySeat(obj) then
                _lockSeatCurrentSeat = obj
                return true
            end
        end
    end
    return false
end

local function lockSeat_startWatchdog()
    if _lockSeatWatchdogActive then return end
    _lockSeatWatchdogActive = true
    task.spawn(function()
        while _lockSeatWatchdogActive do
            task.wait(0.3)
            if not LockSeatEnabled then task.wait(0.5) continue end
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if not humanoid then return end
                local vehicle = getMyVehicle()
                if not vehicle then return end
                local isSeated = humanoid.SeatPart and humanoid.SeatPart.Parent
                if not isSeated then lockSeat_forceSit(humanoid, vehicle) end
            end)
        end
    end)
end

local function lockSeat_stopWatchdog()
    _lockSeatWatchdogActive = false
    _lockSeatCurrentSeat = nil
    if _lockSeatPropertyConnection then
        _lockSeatPropertyConnection:Disconnect()
        _lockSeatPropertyConnection = nil
    end
end

local function lockSeat_bindListener()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    if _lockSeatPropertyConnection then _lockSeatPropertyConnection:Disconnect() end
    _lockSeatPropertyConnection = humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
        if not LockSeatEnabled then return end
        if not humanoid.SeatPart then
            task.spawn(function()
                task.wait(0.1)
                if not LockSeatEnabled then return end
                local c = LocalPlayer.Character
                if not c then return end
                local h = c:FindFirstChildOfClass("Humanoid")
                if not h then return end
                if h.SeatPart then return end
                local v = getMyVehicle()
                if v then lockSeat_forceSit(h, v) end
            end)
        end
    end)
end

