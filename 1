local function restartAutoDrive()
    if _restarting then return end
    _restarting = true
    
    warn("[Auto-Drive] Restarting loop (anti-stuck)...")
    
    _loopGeneration = _loopGeneration + 1
    autoDriveActive = false
    
    adTargetPos = nil
    adFinishPos = nil
    currentTargetPosition = nil
    jobState = "NONE"
    currentJobId = nil
    
    task.wait(2)
    
    autoDriveActive = true
    _lastProgressTick = tick()
    _restarting = false
    task.spawn(autoRunJob)
end

