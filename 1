local function createDeliveryInput(nameText, defaultVal, yPos, updateKey)
    local lbl = Instance.new("TextLabel", ContainerMaxgen)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 0, 0, yPos)
