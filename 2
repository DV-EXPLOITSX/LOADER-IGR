local function formatRupiah(amount)
	local formatted = tostring(amount)
	local k = ""
	while #formatted > 3 do
		k = "."..string.sub(formatted,-3)..k
		formatted = string.sub(formatted,1,#formatted-3)
	end
	return formatted..k
end

