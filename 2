local function RunAutoBuyTask(itemName, data)
	if not AutoBuyTasks[itemName] then
		AutoBuyTasks[itemName] = task.spawn(function()
			while data.isAutoBuying do
				local targetQty = data.autoQty or 1
				local intervalSec = (data.autoMinutes or 1) * 60
				local success, serverItems = pcall(function()
					return GetShopItems:InvokeServer(currentTokoName, "Semua")
				end)
				local hasStock = false
				if success and type(serverItems) == "table" then
					for _, sItem in pairs(serverItems) do
						local sName = sItem.Name or sItem[1]
						if sName == itemName then
							local sStock = tonumber(sItem.Stock or sItem.Stok or sItem.Quantity) or 999
							if sStock >= targetQty then
								hasStock = true
							end
							break
						end
					end
				end
				if hasStock then
					local pSuccess, pMsg = pcall(function()
						return PurchaseEvent:InvokeServer(itemName, targetQty)
					end)
					if pSuccess and pMsg ~= false then
						ShowNotif("[AUTO] Sukses Beli " .. targetQty .. "x " .. itemName)
					else
						ShowNotif("[AUTO] Gagal beli " .. itemName, true)
					end
					local elapsed = 0
					while elapsed < intervalSec and data.isAutoBuying do
						task.wait(1)
						elapsed += 1
					end
				else
					ShowNotif("[AUTO] Stok " .. itemName .. " kosong...", true)
					task.wait(5)
				end
			end
			AutoBuyTasks[itemName] = nil
		end)
	end
end

