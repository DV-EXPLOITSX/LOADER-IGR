local function ApplyRainbow(uiObject, isBackground)
	task.spawn(function()
		local hue = math.random()
		while uiObject and uiObject.Parent do
			hue = (hue + 0.02) % 1 -- Dipercepat agar border makin cepat warnanya
			local col = Color3.fromHSV(hue, 0.9, 1)
			if isBackground then
				uiObject.BackgroundColor3 = col
			else
				uiObject.Color = col
			end
			task.wait(0.015) -- Delay dipercepat ke 0.015 detik
		end
	end)
end

