local function setLockSeat(state)
    if state and not autoDeliveryActive then
        pcall(function()
            StarterGui:SetCore("SendNotification", {Title = "Lock Seat", Text = "⚠️ Nyalain Delivery dulu!", Duration = 3})
        end)
        return false
    end
    LockSeatEnabled = state
    if state then
        pcall(function()
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local vehicle = getMyVehicle()
            if humanoid and vehicle then lockSeat_forceSit(humanoid, vehicle) end
        end)
        lockSeat_bindListener()
        lockSeat_startWatchdog()
    else
        lockSeat_stopWatchdog()
    end
    updateLockSeatVisual()
    return true
end

