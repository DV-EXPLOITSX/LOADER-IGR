end)

CloseBtn.MouseButton1Click:Connect(function()
    if bypassActive then
        restoreMap()
    end
    if wheelsBypassActive then
        wheelsBypassActive = false
        restoreWheels()
    end
    ScreenGui:Destroy()
end)

task.spawn(function()
    while ScreenGui.Parent do
        task.wait(5)
        if bypassActive then
            local mapFolder = workspace:FindFirstChild("Map")
            if mapFolder then
                local newCount = 0
                for _, obj in pairs(mapFolder:GetDescendants()) do
                    if obj.Parent and isSafeToDelete(obj) then
                        pcall(function()
                            savedObjects[obj] = obj.Parent
                            obj.Parent = nil
                            deletedCount = deletedCount + 1
                            newCount = newCount + 1
                        end)
                    end
                end
                if newCount > 0 then
                    totalTarget = totalTarget + newCount
                    updateProgress(deletedCount, totalTarget)
                    CountLabel.Text = "Deleted: " .. deletedCount .. "  |  Auto-clean +" .. newCount
                end
            end
        end
    end
end)

task.spawn(function()
    Workspace.ChildAdded:Connect(function(child)
        if child.Name == "BP" and wheelsBypassActive then
            task.wait(1)
            pcall(applyWheelsBypass)
        end
    end)
end)
